# Copy values into your deployment platform's environment variable settings.
# Never commit the real .env file — it is git-ignored.

# Port the server listens on (falls back to 3000 if unset)
PORT=3000

# Display name shown in the UI (proves env vars propagated through deployment)
APP_NAME=Aozumi Test Bench

# Optional: enables the /api/summarize endpoint via HuggingFace Inference API.
# Set this in your hosting environment, never in the repo.
HF_TOKEN=

# Optional: override the summarization model
HF_MODEL=facebook/bart-large-cnn
